[Unit]
Description=pocketkey virtual FIDO device helper socket
Documentation=https://github.com/yousafsyed/pocketkey

[Socket]
ListenStream=/run/pocketkey/uhid.sock
# Only members of the pocketkey group (see sysusers.d/pocketkey.conf) may ask
# for a device. The helper keeps the /dev/uhid descriptor and relays only
# input reports and report replies, so a member cannot re-create the device
# as something else; the group restriction is defence in depth and limits
# who can present a FIDO key at all. The helper enforces one device per uid.
SocketUser=root
SocketGroup=pocketkey
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
