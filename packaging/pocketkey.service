[Unit]
Description=pocketkey virtual FIDO2 security key (phone hybrid transport proxy)
Documentation=https://github.com/yousafsyed/pocketkey
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The device descriptor comes from the system helper (pocketkey-uhid.socket);
# this user service never needs access to /dev/uhid.
ExecStart=/usr/bin/pocketkey
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
# Keep the window on the user's display.
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=default.target
